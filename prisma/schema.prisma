// Prisma schema for melostars
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// NextAuth Models
// --------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --------------------------------------
// Core Application Models & Enums
// --------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TrackStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum TransactionType {
  PURCHASE
  GENERATION
  REFUND
  BONUS
  SUBSCRIPTION_REFILL
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?  @map("email_verified")
  image         String?
  passwordHash  String?    @map("password_hash") // Pour inscription Credentials (bcrypt)
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)

  // Gestion des crédits (Notes)
  credits       Int        @default(10) // Solde initial de notes pour nouveaux utilisateurs

  // Facturation Stripe
  stripeCustomerId       String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId   String?   @unique @map("stripe_subscription_id")
  stripePriceId          String?   @map("stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map("stripe_current_period_end")

  // Relations
  accounts           Account[]
  sessions           Session[]
  tracks             Track[]
  creditTransactions CreditTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Track {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  title        String
  prompt       String?     @db.Text
  lyrics       String?     @db.Text
  genre        String?
  moods        String[]    @default([])
  vocalType    String?     @map("vocal_type") // "male" | "female" | "instrumental"
  language     String?     @default("Français")
  duration     Int         @default(194) // en secondes

  // Fichiers multimédias S3 / R2
  audioUrl     String?     @map("audio_url")
  coverUrl     String?     @map("cover_url")
  s3AudioKey   String?     @map("s3_audio_key")
  s3CoverKey   String?     @map("s3_cover_key")

  // Suivi de la tâche BullMQ
  jobId        String?     @map("job_id")
  status       TrackStatus @default(PENDING)
  errorMessage String?     @map("error_message") @db.Text
  progress     Int         @default(0) // 0 à 100%
  isFavorite   Boolean     @default(false) @map("is_favorite")
  isPublic     Boolean     @default(true) @map("is_public")
  playCount    Int         @default(0) @map("play_count")
  likesCount   Int         @default(0) @map("likes_count")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("tracks")
}

model CreditTransaction {
  id              String          @id @default(cuid())
  userId          String          @map("user_id")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount          Int             // Ex: -2 pour génération, +20 pour recharge
  balanceAfter    Int             @map("balance_after")
  type            TransactionType
  description     String?
  trackId         String?         @map("track_id")
  
  // Détails financiers optionnels (pour achats réels)
  stripePaymentId String?         @map("stripe_payment_id")
  amountMoney     Int?            @map("amount_money") // Montant payé en devise (ex: 2000 XAF)
  currency        String?         @default("xaf")
  paymentMethod   String?         @default("Stripe") @map("payment_method") // Stripe, Mobile Money, Admin
  metadata        Json?

  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("credit_transactions")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String?  @map("admin_id")
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_logs")
}
